# Salin file ini jadi ".env" lalu isi nilai aslinya. JANGAN commit file ".env" ke git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=metrosnack
DB_USER=postgres
DB_PASSWORD=isi_password_asli_disini

# Generate secret acak, misal: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=isi_secret_acak_yang_panjang_disini
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Untuk production, ganti "*" dengan domain/app resmi kamu, pisahkan dengan koma
CORS_ORIGINS=*
